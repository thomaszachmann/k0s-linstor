{
  "title": "LINSTOR und DRBD",
  "uid": "linstor-drbd",
  "tags": [
    "linstor",
    "drbd",
    "storage"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "LINSTOR-Nodes",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "linstor_node_state",
          "legendFormat": "{{node}}",
          "instant": true
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "OFFLINE",
                  "color": "red"
                },
                "1": {
                  "text": "CONNECTED",
                  "color": "orange"
                },
                "2": {
                  "text": "ONLINE",
                  "color": "green"
                },
                "3": {
                  "text": "VERSION_MISMATCH",
                  "color": "red"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "DRBD: ohne Quorum / suspendiert / getrennt",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(drbd_device_quorum == 0) or vector(0)",
          "legendFormat": "ohne Quorum",
          "instant": true
        },
        {
          "refId": "B",
          "expr": "count(drbd_resource_suspended == 1) or vector(0)",
          "legendFormat": "suspendiert",
          "instant": true
        },
        {
          "refId": "C",
          "expr": "count(drbd_connection_state{drbd_connection_state!=\"Connected\"} == 1) or vector(0)",
          "legendFormat": "Verbindungen getrennt",
          "instant": true
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "bargauge",
      "title": "Freier Platz je Pool und Node",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "expr": "linstor_storage_pool_capacity_free_bytes / (linstor_storage_pool_capacity_total_bytes > 0)",
          "legendFormat": "{{node}} {{storage_pool}}"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "namePlacement": "top"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.15
              },
              {
                "color": "green",
                "value": 0.3
              }
            ]
          },
          "custom": {}
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "DRBD Out-of-Sync je Ressource und Partner",
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "label_replace(sum by (name, instance, conn_name) (drbd_peerdevice_outofsync_bytes), \"name\", \"$1\", \"name\", \"(pvc-[0-9a-f]{8}).*\")",
          "legendFormat": "{{instance}}→{{conn_name}} {{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "right",
          "calcs": []
        }
      }
    },
    {
      "id": 5,
      "type": "state-timeline",
      "title": "DRBD-Ressourcen: alle Verbindungen aufgebaut?",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "label_replace(min by (name) (drbd_connection_state{drbd_connection_state=\"Connected\"}), \"name\", \"$1\", \"name\", \"(pvc-[0-9a-f]{8}).*\")",
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "getrennt",
                  "color": "red"
                },
                "1": {
                  "text": "Connected",
                  "color": "green"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "rowHeight": 0.8
      }
    },
    {
      "id": 6,
      "type": "logs",
      "title": "Logs: LINSTOR, drbd-reactor und DRBD im Kernel",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"journal\", unit=~\"linstor-.*|drbd-reactor.service\"} !~ \"REST/API|/metrics|Assembled error reports\""
        },
        {
          "refId": "B",
          "expr": "{job=\"journal\", transport=\"kernel\"} |= \"drbd\""
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    }
  ]
}