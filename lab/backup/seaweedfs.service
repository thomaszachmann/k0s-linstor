[Unit]
Description=SeaweedFS S3 für Velero-Backups (dritter Standort)
After=network-online.target

[Service]
ExecStart=/usr/local/bin/weed server -dir=/var/lib/seaweedfs -ip=172.16.0.176 -s3 -s3.port=8333 -s3.config=/etc/seaweedfs/s3.json -master.volumeSizeLimitMB=1024
Restart=on-failure

[Install]
WantedBy=multi-user.target
